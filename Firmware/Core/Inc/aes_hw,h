#ifndef AES_HW_H
#define AES_HW_H

#include <stdint.h>

/* Thin wrapper over the STM32U5 AES hardware accelerator (HAL_CRYP).
 * AES-128, ECB and CBC. One 16-byte block = 4 x 32-bit words.
 *
 * The hcryp handle and MX_AES_Init() are generated by CubeMX. We only
 * (re)load the key/mode here and drive encrypt/decrypt for benchmarking.
 *
 * IMPORTANT: HAL_CRYP_Encrypt's Size argument is in WORDS, not bytes.
 * A single AES block is therefore Size = 4. */

/* ---- ECB ---- */
int aes_hw_init_ecb(const uint32_t key[4]);
int aes_hw_encrypt_ecb(const uint32_t *in, uint32_t *out, uint32_t nblocks);
int aes_hw_decrypt_ecb(const uint32_t *in, uint32_t *out, uint32_t nblocks);

/* ---- CBC (requires a 128-bit IV, 4 words) ---- */
int aes_hw_init_cbc(const uint32_t key[4], const uint32_t iv[4]);
int aes_hw_encrypt_cbc(const uint32_t *in, uint32_t *out, uint32_t nblocks);
int aes_hw_decrypt_cbc(const uint32_t *in, uint32_t *out, uint32_t nblocks);

#endif /* AES_HW_H */
